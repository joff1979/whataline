{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "Backend (.NET API)",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/Whataline.Api/Whataline.Api.csproj", "--launch-profile", "http"],
      "port": 5000
    }
  ]
}
